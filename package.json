{
  "name": "repo-shortcuts",
  "version": "0.1.0",
  "description": "Obsidian plugin that renders repository info, git status, and open-in shortcuts from code blocks.",
  "main": "main.js",
  "type": "module",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc --noEmit --skipLibCheck && node esbuild.config.mjs production",
    "test": "node --experimental-strip-types --no-warnings --test test/*.test.ts"
  },
  "keywords": [
    "obsidian",
    "git"
  ],
  "author": "nathanaday",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^26.6.6",
    "esbuild": "^0.28.2",
    "obsidian": "^1.14.4",
    "tslib": "^2.9.1",
    "typescript": "^7.0.2"
  }
}
